# Template for /etc/aiscast.env (0600, root-owned). apply.sh installs it on a box that has
# no env file yet and never overwrites an existing one; secrets stay on the box, not in git.
# Never set ALLOW_ANON here.
ADDR=:8080
# Comma-separated [label=]host:port; /metrics counts datagrams per label.
UDP_ADDR=:10110
ARCHIVE_DIR=/var/lib/aiscast/archive
USAGE=/var/lib/aiscast/vessels-usage.json
# The vessel record, one SQLite file, which also restores the live map on boot. Copy it when replacing the box.
STORE=/var/lib/aiscast/aiscast.db
# Tracks, in ClickHouse on this box: every copy of every position report, and positions_1m. Unset writes
# nothing there, and track requests answer 503.
CLICKHOUSE_URL=
# Historical archives: MARINECADASTRE=1 loads the U.S. Coast Guard's archive. Loads run only as the loader
# user, clickhouse://loader@127.0.0.1:9000/aiscast, whose profile keeps them from starving the live writer.
MARINECADASTRE=
CLICKHOUSE_LOADER_URL=
# Auth: kid:base64pub[,kid:base64pub]. The issuer seed for minting tokens stays in the
# repo's untracked .env (ISSUER_SEED/ISSUER_KID), never on the box.
ISSUER_PUBKEYS=
PERSONAL_ISSUER_KEY=
# Keeps UDP station ids, and the access log's client hashes, stable across restarts.
STATION_SALT=
# Revoked token subjects, comma-separated.
#REVOKED_SUBS=
# Archive uploads to R2 over the S3 API. S3_ENDPOINT/S3_REGION override for non-R2 stores.
R2_BUCKET=ais-archive
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# The normalized event stream, uploaded beside the raw archive under normalized/v1/ with the same
# credentials. NORMALIZED_DIR is local staging that mirrors the bucket's layout. Unset bucket = local only.
NORMALIZED_DIR=/var/lib/aiscast/normalized
NORMALIZED_BUCKET=ais-archive
DEDUPE=/var/lib/aiscast/dedupe.json
# Access log staging; ACCESS_BUCKET is its own private bucket, never the archive's, which is meant to become public.
ACCESS_DIR=/var/lib/aiscast/access
ACCESS_BUCKET=ais-access
# Upstreams.
AISSTREAM_API_KEY=
BARENTSWATCH_CLIENT_ID=
BARENTSWATCH_CLIENT_SECRET=
# AISHub reciprocity: our received stream forwards to AISHub's assigned UDP host:port.
AISHUB_USERNAME=
AISHUB_FEED=
# Only when Cloudflare proxying is on for ais.openwaters.io.
#TRUST_CF_HEADERS=1
# net/http/pprof listens here, loopback only; off turns it off.
#PPROF_ADDR=127.0.0.1:6060
