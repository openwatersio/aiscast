# Reloads and shutdown must not wait on in-flight requests, including open /v1/stream SSE
# responses: close them after 10s and let clients reconnect. WebSockets are hijacked and not
# covered by this; stream_close_delay below handles them.
# `metrics` adds per-request series to the admin endpoint's /metrics on localhost:2019, which
# Alloy scrapes. It needs Caddy 2.9 or later.
{
	grace_period 10s
	metrics
}

# TLS for the hub. Let's Encrypt HTTP-01 works through the Cloudflare proxy; ACME retries until DNS points here.
ais.openwaters.io {
	# Full client addresses for abuse response, under two weeks; README: Access logs.
	log {
		output file /var/log/caddy/access.log {
			roll_size 100MiB
			roll_interval 24h
			roll_keep 500
			roll_keep_for 288h
		}
		format filter {
			# the usual token parameter names, around and bbox, and a token anywhere in the URI, in the usual encodings
			request>uri regexp "(?i)([?&](?:key|token|api_?key|access_token|around|bbox)=)[^&]*|(?:a|%61)(?:k|%6b)(?:1|%31)(?:\.|%2e)[^&/?]*" "${1}REDACTED"
			# a token can arrive under any header name
			request>headers delete
		}
	}
	log_append request_id {http.request.uuid}
	@metrics path /metrics
	respond @metrics 404
	encode zstd gzip
	reverse_proxy localhost:8080 {
		header_up X-Request-Id {http.request.uuid}
		# Stalled client blocks the reload, so close on a timer after a reload
		stream_close_delay 30s
	}
}
