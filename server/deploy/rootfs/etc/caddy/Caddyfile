# Reloads and shutdown must not wait on in-flight requests, including open /v1/stream SSE
# responses: close them after 10s and let clients reconnect. WebSockets are hijacked and not
# covered by this; stream_close_delay below handles them.
# `metrics` adds per-request series to the admin endpoint's /metrics on localhost:2019, which
# Alloy scrapes. It needs Caddy 2.9 or later.
{
	grace_period 10s
	metrics
}

# TLS for the hub. Let's Encrypt HTTP-01 works through the Cloudflare proxy; ACME retries until DNS points here.
ais.openwaters.io {
	# Every request with the client's full address, kept under two weeks, for finding who is behind load
	# while it matters. aiscast's own access log keeps only the network and a keyed hash; the request id joins
	# a line there to its line here. Tokens arrive in the key parameter or the Authorization header, and
	# neither is written. Referer goes too: a page that embeds the map can carry its own token in its URL,
	# and aiscast's log keeps the referer without its query. The file rolls daily, so it is never more than a day old, and a rolled file is
	# deleted after 13 days.
	log {
		output file /var/log/caddy/access.log {
			roll_size 100MiB
			roll_interval 24h
			roll_keep 500
			roll_keep_for 312h
		}
		format filter {
			request>uri query {
				delete key
			}
			request>headers>Authorization delete
			request>headers>Cookie delete
			request>headers>Referer delete
		}
	}
	log_append request_id {http.request.uuid}
	@metrics path /metrics
	respond @metrics 404
	encode zstd gzip
	reverse_proxy localhost:8080 {
		header_up X-Request-Id {http.request.uuid}
		# Stalled client blocks the reload, so close on a timer after a reload
		stream_close_delay 30s
	}
}
