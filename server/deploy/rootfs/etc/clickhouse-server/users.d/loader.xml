<!-- The user archive loads run as (CLICKHOUSE_LOADER_URL), so a load can never take the memory, threads, or
     priority the live writer needs: ClickHouse refusing the writer for 10 minutes drops live positions. -->
<clickhouse>
    <profiles>
        <loader>
            <max_memory_usage>1500000000</max_memory_usage>
            <max_threads>2</max_threads>
            <max_insert_threads>1</max_insert_threads>
            <max_bytes_before_external_sort>500000000</max_bytes_before_external_sort>
            <max_bytes_before_external_group_by>500000000</max_bytes_before_external_group_by>
            <http_receive_timeout>600</http_receive_timeout>
            <max_execution_time>3600</max_execution_time>
            <!-- A reload deletes its day before it loads it again, so the delete has to be done when it returns. -->
            <lightweight_deletes_sync>2</lightweight_deletes_sync>
            <!-- Rows past the cold tier's 30 days are written straight to R2, which needs one part size (s3.xml). -->
            <s3_strict_upload_part_size>16777216</s3_strict_upload_part_size>
            <!-- Higher is later: the writer's queries go first when both wait. -->
            <priority>10</priority>
        </loader>
    </profiles>
    <users>
        <loader>
            <no_password/>
            <networks>
                <ip>127.0.0.1</ip>
                <ip>::1</ip>
            </networks>
            <profile>loader</profile>
            <quota>default</quota>
            <grants>
                <!-- The database CLICKHOUSE_URL names; a deployment with another changes it here. -->
                <query>GRANT SELECT, INSERT, CREATE TABLE, DROP TABLE, ALTER DELETE ON aiscast.*</query>
                <query>GRANT READ ON URL, READ ON S3</query>
            </grants>
        </loader>
    </users>
</clickhouse>
