# /etc/systemd/system/packager.service — nightly packaging of the normalized archive into Iceberg
# tables (packager/packager.py; see packager/README.md). Script at /opt/aiscast/packager.py, run by
# uv; env in /etc/aiscast.env (the LAKE_* and R2_* variables). Started by packager.timer.
[Unit]
Description=aiscast packager: the normalized archive to R2 Data Catalog
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=aiscast
Group=aiscast
EnvironmentFile=/etc/aiscast.env
WorkingDirectory=/var/lib/aiscast
# everything the job writes (stage/, raw/, uv's cache via HOME) must live under ReadWritePaths
Environment=PACKAGER_HOME=/var/lib/aiscast/packager
Environment=HOME=/var/lib/aiscast
# A box with no catalog configured yet would otherwise spend the night packaging into a local
# throwaway warehouse. Reading the file keeps the check clear of systemd's variable expansion.
ExecCondition=/usr/bin/grep -q ^LAKE_CATALOG_URI=. /etc/aiscast.env
# No --normalized: the day is fetched from the normalized bucket and deleted after, so the job
# does not depend on what the box still has on disk.
ExecStart=/usr/local/bin/uv run --script /opt/aiscast/packager.py
TimeoutStartSec=2h
MemoryMax=8G
NoNewPrivileges=true
ProtectSystem=strict
PrivateTmp=true
ReadWritePaths=/var/lib/aiscast
