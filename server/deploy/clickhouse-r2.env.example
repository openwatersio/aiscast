# R2 for ClickHouse's cold volume and nightly backups (clickhouse-r2.xml). One S3 token with Object Read &
# Write on both buckets; <account> is R2_ACCOUNT_ID. Unset keys = no cold volume and no backups.
CLICKHOUSE_R2_COLD_URL=https://<account>.r2.cloudflarestorage.com/ais-clickhouse/receptions/
CLICKHOUSE_R2_BACKUP_URL=https://<account>.r2.cloudflarestorage.com/ais-clickhouse-backup/
CLICKHOUSE_R2_ACCESS_KEY_ID=
CLICKHOUSE_R2_SECRET_ACCESS_KEY=
