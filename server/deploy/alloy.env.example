# Template for /etc/alloy.env (0600, root-owned). apply.sh installs it on a box that has no file yet and
# never overwrites an existing one. Alloy stays off until GRAFANA_CLOUD_PROM_URL is filled in.
# Grafana Cloud → the stack → Prometheus → Details: the remote write URL and the numeric user.
GRAFANA_CLOUD_PROM_URL=
GRAFANA_CLOUD_PROM_USER=
# An access policy token with the metrics:write scope.
GRAFANA_CLOUD_TOKEN=
