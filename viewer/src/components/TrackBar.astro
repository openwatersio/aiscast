---
// Docked over the map whenever a vessel is open. It owns its own track fetch rather than
// reusing the page's: it needs the times for the scrubber, it refetches when the range
// changes, and running in the browser lets it send this browser's token, which raises the
// server's cap from 200 positions to 1,000.
const RANGES = [
  { hours: 48, label: "Last 2 days" },
  { hours: 24 * 7, label: "Last week" },
  { hours: 24 * 30, label: "Last month" },
  { hours: 24 * 365, label: "Last year" },
];
---

<div
  data-trackbar
  hidden
  class="pointer-events-auto fixed bottom-3 z-10 hidden w-[min(560px,calc(100%-1.5rem))] md:block"
  style="left: var(--map-left, 0px); right: 0; margin-inline: auto"
>
  <div
    class="pane rounded-full flex items-center gap-2 px-2 py-1.5"
    style="background-color: var(--surface-glass)"
  >
    <div class="relative">
      <button
        type="button"
        data-history-toggle
        class="flex size-8 items-center justify-center rounded-full hover:bg-[var(--surface-subtle)]"
        style="color: var(--text-secondary)"
        aria-label="Choose a time range"
        aria-haspopup="true"
        aria-expanded="false"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="size-5">
          <path d="M3 12a9 9 0 1 0 3-6.7L3 8" />
          <path d="M3 3v5h5" />
          <path d="M12 7v5l3 2" />
        </svg>
      </button>

      <div
        data-history-menu
        hidden
        class="pane absolute bottom-10 left-0 w-56 p-1.5"
        style="background-color: var(--surface-glass)"
        role="menu"
      >
        {
          RANGES.map((r) => (
            <button
              type="button"
              data-range={r.hours}
              class="flex w-full items-center justify-between rounded-md px-2 py-1.5 text-left text-sm hover:bg-[var(--surface-subtle)]"
              style="color: var(--text)"
              role="menuitem"
            >
              <span>{r.label}</span>
              <span class="text-[10px]" style="color: var(--text-muted)" data-range-note />
            </button>
          ))
        }
      </div>
    </div>

    <button
      type="button"
      data-play
      class="flex size-8 shrink-0 items-center justify-center rounded-full hover:bg-[var(--surface-subtle)]"
      style="color: var(--text-secondary)"
      aria-label="Play"
    >
      <svg viewBox="0 0 24 24" fill="currentColor" class="size-4" data-play-icon>
        <path d="M8 5v14l11-7z" />
      </svg>
    </button>

    <input
      type="range"
      data-scrub
      min="0"
      max="0"
      value="0"
      class="h-1 min-w-0 flex-1 cursor-pointer appearance-none rounded-full"
      style="background-color: var(--border)"
      aria-label="Position in track"
    />

    <div class="relative shrink-0">
      <button
        type="button"
        data-scrub-label
        class="w-[8.5rem] rounded-md px-1 py-0.5 text-right text-xs tabular-nums hover:bg-[var(--surface-subtle)]"
        style="color: var(--text-secondary)"
        aria-haspopup="true"
        aria-expanded="false"
      >
        —
      </button>
      {/* Our own list rather than <input type="date">: the native picker anchors to its
          input and opens downward, which from a bar pinned to the bottom lands off-screen.
          It also offers every date in history when the server holds a rolling window. */}
      <div
        data-day-menu
        hidden
        class="pane absolute right-0 bottom-10 w-40 p-1.5"
        style="background-color: var(--surface-glass)"
        role="menu"
      ></div>
    </div>
  </div>
</div>

<style>
  [data-scrub]::-webkit-slider-thumb {
    appearance: none;
    width: 14px;
    height: 14px;
    border-radius: 9999px;
    background: var(--accent);
    border: 2px solid var(--surface);
  }
  [data-scrub]::-moz-range-thumb {
    width: 14px;
    height: 14px;
    border: 2px solid var(--surface);
    border-radius: 9999px;
    background: var(--accent);
  }
</style>

<script>
  // The server keeps a rolling window and clamps anything longer, reporting what it actually
  // covered. A range past that returns the same positions as the window itself, so the menu
  // says which ones the archive does not reach yet rather than offering five identical views.
  const WINDOW_HOURS = 48;
  const SLIDER_STEPS = 1000;

  interface Loaded {
    coords: Array<[number, number]>;
    times: number[];
  }

  let loaded: Loaded = { coords: [], times: [] };
  let playing: ReturnType<typeof setInterval> | undefined;
  let mmsi = 0;
  let hours = 48;
  let endingAt: number | undefined;

  const $ = <T extends Element = HTMLElement>(sel: string) => document.querySelector<T>(sel);
  const bar = () => $<HTMLElement>("[data-trackbar]");
  const scrub = () => $<HTMLInputElement>("[data-scrub]");

  function apiBase() {
    return $<HTMLMetaElement>('meta[name="aiscast:api"]')?.content ?? "";
  }

  function token() {
    try {
      const raw = localStorage.getItem("aiscast.token");
      return raw ? (JSON.parse(raw).token as string) : undefined;
    } catch {
      return undefined;
    }
  }

  function stopPlaying() {
    if (playing) clearInterval(playing);
    playing = undefined;
    const icon = $<SVGElement>("[data-play-icon]");
    if (icon) icon.innerHTML = '<path d="M8 5v14l11-7z" />';
    $("[data-play]")?.setAttribute("aria-label", "Play");
  }

  function label(at: number | undefined) {
    const el = $("[data-scrub-label]");
    if (!el) return;
    el.textContent = at
      ? new Date(at).toLocaleString("en-GB", {
          day: "numeric",
          month: "short",
          hour: "2-digit",
          minute: "2-digit",
          timeZone: "UTC",
        })
      : "—";
  }

  /**
   * The slider runs over time, not over the count of positions. A vessel can report every
   * thirty seconds for an hour and then go unheard for fourteen, and stepping by position
   * would spend the whole bar on the busy hour and one step on the silence.
   */
  function apply(value: number) {
    const app = window.aiscast;
    const { times } = loaded;
    if (!app || !times.length) return;
    const at = times[0]! + (value / SLIDER_STEPS) * (times[times.length - 1]! - times[0]!);
    // At the end, hand the map back to live: the line should follow the vessel again.
    app.ctl.scrubTo(value >= SLIDER_STEPS ? null : at);
    label(at);
  }

  /** The map boots from its own module, and script order between the two is not fixed. */
  function whenBooted(): Promise<void> {
    return new Promise((resolve) => {
      if (window.aiscast) return resolve();
      const timer = setInterval(() => {
        if (!window.aiscast) return;
        clearInterval(timer);
        resolve();
      }, 100);
    });
  }

  async function load() {
    await whenBooted();
    const app = window.aiscast;
    const el = scrub();
    if (!app || !el || !mmsi) return;

    const end = endingAt ?? Date.now();
    const from = new Date(end - hours * 3600e3).toISOString();
    const to = new Date(end).toISOString();
    const key = token();
    // `?key=` rather than an Authorization header: the header makes this a preflighted
    // request, and the deployed server does not allow Authorization on that preflight. It is
    // the same placement the stream uses. Once aiscast#127 ships, this moves to a header and
    // the token leaves the URL, where it lands in logs and the address bar.
    const auth = key ? `&key=${encodeURIComponent(key)}` : "";
    try {
      const res = await fetch(
        `${apiBase()}/v1/vessels/${mmsi}/track?from=${from}&to=${to}&limit=1000${auth}`,
      );
      if (!res.ok) return;
      const t = await res.json();
      const coords: Array<[number, number]> = t.geometry?.coordinates ?? [];
      const times: number[] = (t.properties?.times ?? []).map((x: string) => Date.parse(x));
      loaded = { coords, times };

      el.max = String(SLIDER_STEPS);
      el.value = el.max;
      app.ctl.setTrack(coords, times[times.length - 1] ?? 0, times);
      app.ctl.scrubTo(null);
      label(times[times.length - 1]);
      bar()!.hidden = coords.length < 2;

      // Say what the server actually covered, which for a long range is the window.
      const covered = Math.round((Date.parse(t.properties.to) - Date.parse(t.properties.from)) / 3600e3);
      for (const b of document.querySelectorAll<HTMLElement>("[data-range]")) {
        const wanted = Number(b.dataset.range);
        const note = b.querySelector<HTMLElement>("[data-range-note]");
        const beyond = wanted > WINDOW_HOURS;
        if (note) note.textContent = beyond ? `${WINDOW_HOURS} h available` : "";
        b.style.opacity = beyond ? "0.55" : "1";
        b.style.color = wanted === hours ? "var(--accent)" : "var(--text)";
      }
      void covered;
    } catch {
      // A failed fetch leaves the track as the page rendered it.
    }
  }

  /** The days the rolling window reaches, newest first. */
  function fillDays(menu: HTMLElement) {
    const now = Date.now();
    const days: Array<{ label: string; endsAt: number }> = [];
    for (let back = 0; back * 24 < WINDOW_HOURS + 24; back++) {
      const day = new Date(now - back * 86_400_000);
      const endsAt = Math.min(Date.parse(`${day.toISOString().slice(0, 10)}T23:59:59Z`), now);
      if (now - endsAt > WINDOW_HOURS * 3600e3) break;
      days.push({
        label:
          back === 0
            ? "Today"
            : back === 1
              ? "Yesterday"
              : day.toLocaleDateString("en-GB", { day: "numeric", month: "short", timeZone: "UTC" }),
        endsAt,
      });
    }

    menu.replaceChildren();
    for (const d of days) {
      const b = document.createElement("button");
      b.type = "button";
      b.className =
        "flex w-full items-center justify-between rounded-md px-2 py-1.5 text-left text-sm hover:bg-[var(--surface-subtle)]";
      b.style.color = "var(--text)";
      b.textContent = d.label;
      b.addEventListener("click", () => {
        endingAt = d.endsAt;
        stopPlaying();
        menu.hidden = true;
        void load();
      });
      menu.append(b);
    }

    const note = document.createElement("p");
    note.className = "mt-1 border-t px-2 pt-1.5 text-[10px]";
    note.style.color = "var(--text-muted)";
    note.textContent = `${WINDOW_HOURS} hours of history available`;
    menu.append(note);
  }

  function wire() {
    const el = scrub();
    const b = bar();
    if (!el || !b || b.dataset.wired) return;
    b.dataset.wired = "1";

    el.addEventListener("input", () => {
      stopPlaying();
      apply(Number(el.value));
    });

    $("[data-play]")?.addEventListener("click", () => {
      if (playing) return stopPlaying();
      if (loaded.coords.length < 2) return;
      if (Number(el.value) >= Number(el.max)) el.value = "0";
      // Replay is useless off-screen, and a track can run well outside the current view.
      window.aiscast?.ctl.fitTrack();
      const icon = $<SVGElement>("[data-play-icon]");
      if (icon) icon.innerHTML = '<path d="M6 5h4v14H6zM14 5h4v14h-4z" />';
      $("[data-play]")?.setAttribute("aria-label", "Pause");
      playing = setInterval(() => {
        const next = Number(el.value) + SLIDER_STEPS / 240;
        if (next > Number(el.max)) return stopPlaying();
        el.value = String(next);
        apply(next);
      }, 90);
    });

    const menu = $("[data-history-menu]");
    $("[data-history-toggle]")?.addEventListener("click", () => {
      if (!menu) return;
      menu.hidden = !menu.hidden;
      $("[data-history-toggle]")?.setAttribute("aria-expanded", String(!menu.hidden));
    });
    document.addEventListener("click", (e) => {
      if (!menu || menu.hidden) return;
      if (!(e.target as Element).closest("[data-history-menu],[data-history-toggle]")) menu.hidden = true;
    });

    for (const button of document.querySelectorAll<HTMLElement>("[data-range]")) {
      button.addEventListener("click", () => {
        hours = Number(button.dataset.range);
        stopPlaying();
        if (menu) menu.hidden = true;
        void load();
      });
    }

    $("[data-scrub-label]")?.addEventListener("click", () => {
      const menu = $("[data-day-menu]");
      if (!menu) return;
      if (menu.hidden) fillDays(menu);
      menu.hidden = !menu.hidden;
      $("[data-scrub-label]")?.setAttribute("aria-expanded", String(!menu.hidden));
    });

    document.addEventListener("click", (e) => {
      const menu = $("[data-day-menu]");
      if (!menu || menu.hidden) return;
      if (!(e.target as Element).closest("[data-day-menu],[data-scrub-label]")) menu.hidden = true;
    });
  }

  function start() {
    const next = Number(document.body.dataset.focusMmsi ?? 0);
    const b = bar();
    if (!b) return;
    wire();
    if (!next) {
      stopPlaying();
      b.hidden = true;
      window.aiscast?.ctl.scrubTo(null);
      return;
    }
    if (next !== mmsi) {
      stopPlaying();
      mmsi = next;
      endingAt = undefined;
      loaded = { coords: [], times: [] };
    }
    void load();
  }

  start();
  document.addEventListener("astro:after-swap", start);
</script>
