---
import { CLASS_COLORS, CLASS_LABELS, NAV_STATUS, flagEmoji, flagName, formatCoord, parseDestination, parseEta, relativeTime, shipClass } from "../lib/ais";
import { API_PUBLIC, type Track, type VesselFeature } from "../lib/api";

interface Props {
  mmsi: number;
  feature: VesselFeature | undefined;
  track?: Track;
}

const { mmsi, feature, track } = Astro.props;
const points = track?.properties.points ?? 0;
const trackCoords = track?.geometry?.coordinates ?? [];
const trackFrom = track?.properties.times?.[0];
const trackTimes = track?.properties.times ?? [];
const trackEnd = trackTimes.length ? Date.parse(trackTimes[trackTimes.length - 1]!) : 0;
const p = feature?.properties;
const cls = shipClass(p?.kind, p?.type);
const [lon, lat] = feature?.geometry?.coordinates ?? [];
const country = flagName(p?.flag);

// `/v1/vessels` carries the particulars now, so the page is complete in its first response
// instead of filling in when a type 5 happens to arrive over the stream.
const size = p?.length ? `${p.length} × ${p.beam ?? "?"} m` : undefined;

// AIS gives a destination and an ETA and nothing else about the voyage: no origin, no
// departure time, no distance run. So this shows where the crew says they are going and
// when, and does not draw a progress bar it has no way to position.
const eta = parseEta(p?.eta);
const etaText = eta
  ? eta.toLocaleString("en-GB", {
      day: "numeric",
      month: "short",
      hour: "2-digit",
      minute: "2-digit",
      timeZone: "UTC",
    })
  : p?.eta;
const voyage = parseDestination(p?.destination);
const hasVoyage = Boolean(voyage || p?.eta);

// Identifiers belong with the name, not in the table of things that change.
// Speed, course and heading are what a reader glances at, so they are read at a glance
// rather than looked up in a table. Shown even when absent: a blank under "Speed" says the
// vessel is not reporting it, where an omitted row says nothing at all.
const motion = [
  // A degree sign sits tight against its number; a unit word takes a non-breaking space.
  { label: "Speed", value: p?.sog != null ? p.sog.toFixed(1) : undefined, unit: "\u00a0kn" },
  { label: "Course", value: p?.cog != null ? Math.round(p.cog).toString() : undefined, unit: "°" },
  { label: "Heading", value: p?.heading != null ? String(p.heading) : undefined, unit: "°" },
];

// Navigational status is what the speed, course and heading below mean: 0.0 knots reads
// very differently under "At anchor" than under "Under way using engine".
const navStatus =
  p?.nav_status != null ? (NAV_STATUS[p.nav_status] ?? `Status ${p.nav_status}`) : undefined;

const ids = [
  `MMSI ${mmsi}`,
  p?.imo ? `IMO ${p.imo}` : undefined,
  p?.callsign ? `Call sign ${p.callsign}` : undefined,
].filter(Boolean);
const LABEL = "text-[11px] font-medium tracking-wide uppercase";
const TILE = "tile-surface mt-1.5 rounded-lg p-3";

const rows: Array<[string, string | undefined]> = [
  ["Draught", p?.draught ? `${p.draught.toFixed(1)} m` : undefined],
  ["Size", size],
];
---

<article
  data-vessel={mmsi}
  data-track={trackCoords.length > 1 ? JSON.stringify(trackCoords) : undefined}
  data-track-end={trackEnd || undefined}
  data-seed={feature
    ? JSON.stringify({
        mmsi,
        name: p!.name,
        shipType: p!.type,
        kind: p!.kind,
        lat,
        lon,
        cog: p!.cog,
        sog: p!.sog,
        heading: p!.heading,
        navStatus: p!.nav_status,
        seen: Date.parse(p!.seen),
        source: p!.source,
        station: p!.station,
      })
    : undefined}
>
  <div class="flex items-start gap-3">
    <div class="min-w-0">
      <p class="text-sm" style="color: var(--text-muted)">
        {country && <span class="mr-1">{flagEmoji(p!.flag)} {country}</span>}
      </p>
      <h1 class="truncate text-2xl font-semibold" style="color: var(--text)">
        {p?.name ?? `MMSI ${mmsi}`}
      </h1>
      <p class="text-xs" style="color: var(--text-muted)">
        <span>{CLASS_LABELS[cls]}</span>
        {p?.type && <span> · type {p.type}</span>}
      </p>
      <p class="mt-0.5 text-xs" style="color: var(--text-muted)">
        {ids.join(" · ")}
      </p>
    </div>
  </div>


  {/* Three sections, one shape: a label row above a tile, and every tile the same
      surface. The label row's right-hand slot carries whatever qualifies the tile. */}
  {
    feature && lat != null && (
      <>
        <div class="mt-4 flex items-baseline justify-between gap-2">
          <h2 class={LABEL} style="color: var(--text-muted)">Last position</h2>
          <time
            class="text-[11px] first-letter:uppercase"
            style="color: var(--text-muted)"
            datetime={p!.seen}
            title={p!.seen}
          >
            {relativeTime(new Date(p!.seen))}
          </time>
        </div>
        <section class={`${TILE} flex items-center gap-3`}>
          <span
            class="flex size-9 shrink-0 items-center justify-center rounded-full"
            style="background-color: var(--surface); color: var(--accent)"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="size-5">
              <path d="M12 21s7-5.5 7-11a7 7 0 1 0-14 0c0 5.5 7 11 7 11Z" />
              <circle cx="12" cy="10" r="2.5" />
            </svg>
          </span>
          <div class="min-w-0 font-mono text-xs" style="color: var(--text-secondary)">
            {formatCoord(lat, lon!)}
          </div>
        </section>
      </>
    )
  }

  {hasVoyage && (
    <>
      <div class="mt-4 flex items-baseline justify-between gap-2">
        <h2 class={LABEL} style="color: var(--text-muted)">Destination</h2>
      </div>
      <section class={TILE} title={p!.destination}>
        <div class="flex items-center gap-2">
          {voyage?.from && (
            <>
              <span class="truncate text-sm" style="color: var(--text-secondary)">
                {voyage.from.flag} {voyage.from.code ?? voyage.from.raw}
              </span>
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                class="size-4 shrink-0"
                style="color: var(--text-muted)"
                aria-label="to"
              >
                <path d="M5 12h14M13 6l6 6-6 6" />
              </svg>
            </>
          )}
          <span class="truncate text-base font-semibold" style="color: var(--text)">
            {voyage?.to ? `${voyage.to.flag ?? ""} ${voyage.to.code ?? voyage.to.raw}`.trim() : "Not reported"}
          </span>
        </div>
        {voyage?.to?.country && (
          <div class="text-sm" style="color: var(--text-secondary)">
            {voyage.to.country}
          </div>
        )}
      </section>
    </>
  )}

  {
    points > 1 && (
      <>
        <div class="mt-4 flex items-baseline justify-between gap-2">
          <h2 class={LABEL} style="color: var(--text-muted)">Track</h2>
          <a
            class="text-[11px]"
            href={`${API_PUBLIC}/v1/vessels/${mmsi}/track?format=gpx`}
            download={`${mmsi}.gpx`}
          >
            Download GPX
          </a>
        </div>
        <section class={`${TILE} flex items-baseline justify-between gap-2 text-sm`}>
          <span style="color: var(--text)">
            {points.toLocaleString("en-US")} positions
          </span>
          <span class="text-xs" style="color: var(--text-muted)">
            {trackFrom ? `since ${relativeTime(new Date(trackFrom))}` : ""}
          </span>
        </section>
      </>
    )
  }

  {
    feature && (
      <>
        <div class="mt-4 flex items-baseline justify-between gap-2">
          <h2 class={LABEL} style="color: var(--text-muted)">{navStatus ?? "Motion"}</h2>
        </div>
        <section class={`${TILE} grid grid-cols-3 gap-2`}>
          {motion.map((m) => (
            <div class="text-center">
              {/* Value and unit stay on one source line: a newline between them collapses
                  to a space, which puts a gap in front of the degree sign. */}
              <div class="text-xl leading-tight font-semibold tabular-nums" style="color: var(--text)">
                {m.value ?? "–"}<span class="font-light" style="color: var(--text-muted)">{m.value ? m.unit : ""}</span></div>
              <div class="text-[11px] tracking-wide uppercase" style="color: var(--text-muted)">
                {m.label}
              </div>
            </div>
          ))}
        </section>
      </>
    )
  }

  {
    feature && (
      <>
        <dl class="mt-4">
          {rows
            .filter(([, v]) => v)
            .map(([k, v]) => (
              <>
                <dt>{k}</dt>
                <dd>{v}</dd>
              </>
            ))}
          <dt>Station</dt>
          <dd class="truncate">
            <a href={`/stations/${p!.station}`}>{p!.station}</a>
          </dd>
        </dl>


        {/* The credit that came with this vessel's own last message, which only the
            stream carries. */}
        <p class="mt-4 text-xs" style="color: var(--text-muted)" data-attribution hidden></p>

      </>
    )
  }
</article>

<script>
  let seeded = false;

  function hydrate() {
    const article = document.querySelector<HTMLElement>("[data-vessel]");
    const app = window.aiscast;
    if (!article || !app) return;
    const mmsi = Number(article.dataset.vessel);

    if (!seeded && article.dataset.seed) {
      seeded = true;
      app.stream.seed(JSON.parse(article.dataset.seed));
      app.ctl.setFocus(mmsi);
      // Separate from the seed: the stream's own track is [lon, lat, time] triples it
      // collects live, where this is the server's [lon, lat] history.
      app.ctl.setTrack(
        article.dataset.track ? JSON.parse(article.dataset.track) : [],
        Number(article.dataset.trackEnd ?? 0),
      );
    }

    const v = app.stream.vessels.get(mmsi);
    if (!v) return;

    const credit = article.querySelector<HTMLElement>("[data-attribution]");
    if (credit && v.attribution) {
      credit.textContent = v.license ? `${v.attribution} Licence: ${v.license}.` : v.attribution;
      credit.hidden = false;
    }
  }

  hydrate();
  document.addEventListener("astro:page-load", () => {
    seeded = false;
    hydrate();
  });
  setInterval(hydrate, 2000);
</script>
